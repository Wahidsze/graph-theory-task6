graph G {
  layout=neato;
  node [shape=circle];
  "a" [pos="0,4!"];
  "b" [pos="-1,1!"];
  "c" [pos="0,-4!"];
  "d" [pos="1,-1!"];
  "e" [pos="-4,0!"];
  "f" [pos="0.8,0!"];
  "g" [pos="4,0!"];
  "h" [pos="-0.8,0!"];
  "a" -- "b";
  "a" -- "e";
  "a" -- "g";
  "b" -- "e";
  "b" -- "f";
  "b" -- "h";
  "c" -- "d";
  "c" -- "e";
  "c" -- "g";
  "d" -- "f";
  "d" -- "g";
  "d" -- "h";
  "e" -- "h";
  "f" -- "g";
  "f" -- "h";
}